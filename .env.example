# ═══════════════════════════════════════════
# Property Scrapers — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════

# ── Supabase (REQUIRED) ──
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ── GitHub (OPTIONAL — needed for dashboard commit feature) ──
# Create a PAT at: https://github.com/settings/tokens/new (needs `repo` scope)
GITHUB_TOKEN=your-github-pat
GITHUB_REPO=your-username/property-scrapers
GITHUB_BRANCH=main
